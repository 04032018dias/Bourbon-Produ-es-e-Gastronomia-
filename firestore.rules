rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { function signedIn(){return request.auth != null;} function me(){return get(/databases/$(database)/documents/users/$(request.auth.uid));} function role(){return me().data.role;} function admin(){return signedIn() && role()=='admin';} function manager(){return signedIn() && role() in ['admin','partner'];} match /users/{uid}{allow create: if signedIn() && request.auth.uid==uid; allow read: if signedIn(); allow update: if signedIn() && (request.auth.uid==uid || admin());} match /employees/{id}{allow read: if signedIn(); allow create,update: if manager(); allow delete: if admin();} match /bands/{id}{allow read: if signedIn(); allow create,update: if manager(); allow delete: if admin();} match /audit_logs/{id}{allow create: if signedIn(); allow read: if manager();} } }
