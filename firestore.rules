rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // REGRA TEMPORÁRIA PARA TESTES E PARA O EVENTO.
    // Permite que Administração, venda pública e portaria funcionem sem login.
    // Troque por regras com autenticação assim que o evento terminar.
    match /bourbon/{document} {
      allow read, write: if request.time < timestamp.date(2026, 8, 10);
    }

    match /vendas_online/{document} {
      allow create, read, update: if request.time < timestamp.date(2026, 8, 10);
      allow delete: if false;
    }
  }
}
